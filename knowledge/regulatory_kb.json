  "filing_categories": {
    "FDA": {
      "PAS": {
        "label": "Prior Approval Supplement",
        "basis": "21 CFR 314.70(b)",
        "patterns": [
          "\\bPAS\\b",
          "prior[- ]approval supplement"
        ]
      },
      "CBE-30": {
        "label": "Changes Being Effected in 30 days",
        "basis": "21 CFR 314.70(c)",
        "patterns": [
          "\\bCBE[- ]?30\\b",
          "changes being effected in 30 days"
        ]
      },
      "CBE-0": {
        "label": "Changes Being Effected (immediate)",
        "basis": "21 CFR 314.70(c)(6)",
        "patterns": [
          "\\bCBE[- ]?0\\b",
          "\\bCBE\\b(?![- ]?30)"
        ]
      },
      "AR": {
        "label": "Annual Report",
        "basis": "21 CFR 314.70(d)",
        "patterns": [
          "annual report"
        ]
      }
    },
    "EMA": {
      "IA": {
        "label": "Type IA variation",
        "basis": "Regulation (EC) No 1234/2008",
        "patterns": [
          "type\\s*IA\\b(?!\\s*\\(?IN)"
        ]
      },
      "IAIN": {
        "label": "Type IA(IN) variation",
        "basis": "Regulation (EC) No 1234/2008",
        "patterns": [
          "type\\s*IA\\s*\\(?IN\\)?"
        ]
      },
      "IB": {
        "label": "Type IB variation",
        "basis": "Regulation (EC) No 1234/2008",
        "patterns": [
          "type\\s*IB\\b"
        ]
      },
      "II": {
        "label": "Type II variation",
        "basis": "Regulation (EC) No 1234/2008",
        "patterns": [
          "type\\s*II\\b"
        ]
      },
      "EXT": {
        "label": "Extension application",
        "basis": "Regulation (EC) No 1234/2008 Annex I",
        "patterns": [
          "extension application",
          "line extension"
        ]
      }
    }
  },
  "abstention_patterns": [
    "cannot (?:verify|confirm|find)",
    "unable to (?:verify|confirm|locate|find)",
    "not aware of",
    "could not (?:find|locate|verify)",
    "no (?:such|record of)",
    "does not appear to exist",
    "i do not have (?:reliable )?information",
    "please (?:check|confirm) the (?:exact )?(?:title|source|reference)"
  ]
